# Copy to frontend/.env.development.local (git-ignored) and fill in your own values.
# These identify a Cognito app client; none is a secret. Never add a client secret.
VITE_API_BASE_URL=http://127.0.0.1:8001
VITE_COGNITO_USER_POOL_ID=<region>_<poolid>
VITE_COGNITO_APP_CLIENT_ID=<app-client-id>
VITE_COGNITO_DOMAIN=<domain-prefix>.auth.<region>.amazoncognito.com
VITE_COGNITO_REDIRECT_SIGN_IN=http://localhost:5173/
VITE_COGNITO_REDIRECT_SIGN_OUT=http://localhost:5173/
# Optional, space or comma separated (default: openid)
# VITE_COGNITO_SCOPES=openid

# A production build (npm run build) refuses to run unless these are set to the production values:
#   VITE_API_BASE_URL=https://energy-api.ai-autofy-general-server.com
#   VITE_COGNITO_REDIRECT_SIGN_IN=https://energy.ai-autofy-general-server.com/
#   VITE_COGNITO_REDIRECT_SIGN_OUT=https://energy.ai-autofy-general-server.com/
# plus the Cognito pool, client and domain of the production user pool. Local development uses the values
# above; npm run build:local bundles without that check and must not be deployed.
