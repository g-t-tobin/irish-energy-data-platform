{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Sid": "RegistryLoginTokenNoResourceLevelSupport",
      "Effect": "Allow",
      "Action": [
        "ecr:GetAuthorizationToken"
      ],
      "Resource": "*"
    },
    {
      "Sid": "PushApiImageToProjectRepositoryOnly",
      "Effect": "Allow",
      "Action": [
        "ecr:BatchCheckLayerAvailability",
        "ecr:InitiateLayerUpload",
        "ecr:UploadLayerPart",
        "ecr:CompleteLayerUpload",
        "ecr:PutImage"
      ],
      "Resource": [
        "arn:aws:ecr:eu-west-1:851725545966:repository/irish-energy-api"
      ]
    },
    {
      "Sid": "VerifyApiImage",
      "Effect": "Allow",
      "Action": [
        "ecr:DescribeRepositories",
        "ecr:DescribeImages",
        "ecr:ListImages",
        "ecr:DescribeImageScanFindings"
      ],
      "Resource": [
        "arn:aws:ecr:eu-west-1:851725545966:repository/irish-energy-api"
      ]
    }
  ]
}
